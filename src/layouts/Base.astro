---
import '../styles/global.css';
import Header from '../components/Header.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { services, type PageKey } from '../data/site';

interface Props {
  title: string;
  description: string;
  page: PageKey;
  /** JSON-LD object for this page */
  schema?: object;
}
const { title, description, page, schema } = Astro.props;

const svc = services.find((s) => s.key === page);
const quoteHref = svc ? `/quote/?service=${svc.slug}` : '/quote/';
const bannerQuoteHref = page === 'home' ? '#hero-quote' : page === 'quote' ? '#qform' : '/#hero-quote';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Duct Hunt LLC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#201e1d" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&family=Russo+One&display=swap"
      rel="stylesheet"
    />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <slot name="head" />
  </head>
  <body>
    <div id="top">
      <Header page={page} quoteHref={quoteHref} />
      <main>
        <slot />
      </main>
      <CtaBanner quoteHref={bannerQuoteHref} />
      <Footer />
      <MobileBar quoteHref={quoteHref} />
    </div>
  </body>
</html>
