---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PhotoHero from '../../components/PhotoHero.astro';
import HeroButtons from '../../components/HeroButtons.astro';
import Chips from '../../components/Chips.astro';
import H2 from '../../components/H2.astro';
import IconItems from '../../components/IconItems.astro';
import ArrowItems from '../../components/ArrowItems.astro';
import NumberCards from '../../components/NumberCards.astro';
import Steps from '../../components/Steps.astro';
import ReviewStrip from '../../components/ReviewStrip.astro';
import FaqList from '../../components/FaqList.astro';
import RelatedCards from '../../components/RelatedCards.astro';
import Callout from '../../components/Callout.astro';
import dryerHero from '../../assets/dryer-hero.webp';
import dryerBa from '../../assets/dryer-ba-1.png';
import { business, serviceByKey } from '../../data/site';
import { dryerReviews } from '../../data/reviews';
import { dryerFaqs } from '../../data/faqs';
import { graph, localBusiness, service, faqPage } from '../../data/schema';

const included = [
  ['⇉', 'Full vent line cleaned from the dryer to the exterior'],
  ['⌁', 'Dryer transition duct (the connector behind the dryer)'],
  ['◎', 'Lint buildup removed from the exterior vent opening'],
  ['◔', 'Airflow check after cleaning'],
  ['◩', 'Before & after photos'],
  ['✦', 'Flat-fee pricing, no surprise charges'],
].map(([i, t]) => ({ i, t }));
// Remaining gallery slots until real dryer vent before/after photos arrive
const pairs = ['Lint-packed vs. clean transition duct', 'Clogged vs. clear exterior vent opening'];
const benefits = ['Clothes dry faster', 'Lower energy use per load', 'Reduced fire risk', 'Less wear on your dryer'].map((t) => ({ t }));
const signs = [
  'Clothes take more than one cycle to dry',
  'Dryer or laundry room feels hot',
  'Burning smell when the dryer runs',
  'Lint collecting around the outside vent flap',
  "Vent flap doesn't open when the dryer is running",
  "It's been more than a year since your last cleaning",
];
const steps = [
  { t: 'Call for a flat-fee quote' },
  { t: 'Fast scheduling, often next day' },
  { t: 'Full vent line cleaning with before & after photos' },
  { t: 'Airflow check and tips to keep it clear' },
];
const quoteHref = '/quote/?service=dryer-vent';
---
<Base
  page="dryer"
  title="Dryer Vent Cleaning in Kansas City | Duct Hunt LLC"
  description="Flat-fee dryer vent cleaning in Kansas City and North Kansas City, often available next day. Faster drying, lower fire risk, before & after photos."
  schema={graph(localBusiness(), service('Dryer Vent Cleaning', 'Dryer vent cleaning'), faqPage(dryerFaqs))}
>
  <PhotoHero lead="Dryer Vent Cleaning in" accent="Kansas City">
    <p class="lead">Faster drying, safer home. Flat-fee dryer vent cleaning from a local owner-operator, often available next day.</p>
    <HeroButtons quoteHref={quoteHref} />
    <Chips items={['4.9★ Google', 'Flat-Fee Pricing', 'Next-Day Availability', 'All Work Guaranteed']} />
    <Image
      slot="aside"
      src={dryerHero}
      alt="Exterior dryer vent hood packed with lint"
      width={960}
      loading="eager"
      class="dhero"
    />
  </PhotoHero>

  <section class="sec paper">
    <div class="wrap-880 center">
      <H2 lead="Dryer Vent Cleaning for Homes in" sub="North Kansas City and Beyond" center />
      <p class="body-lg" style="margin:28px 0 0">Every load of laundry sends lint into your dryer vent. Over time it builds up, restricts airflow, and makes your dryer run longer and hotter. A clogged dryer vent is a common cause of house fires and wastes energy on every load.</p>
      <p class="body-lg" style="margin:18px 0 0">Duct Hunt clears the full vent line, from the back of the dryer to the outside exhaust, so your dryer runs the way it should.</p>
    </div>
  </section>

  <Callout
    on="dark"
    tall
    lead="Lint is highly flammable."
    sub="A clogged vent traps heat"
    text="Regular dryer vent cleaning is one of the simplest ways to protect your home."
    cta="Schedule a Cleaning"
    href={business.tel}
    pmax="32em"
    h2Size="clamp(30px,4.6vw,60px)"
  >
    <Fragment slot="after"> and makes your dryer work harder every load.</Fragment>
  </Callout>

  <section class="sec paper">
    <div class="wrap">
      <H2 lead="What's Included in Our Dryer Vent Cleaning" sub="in Kansas City" center />
      <IconItems items={included} card="white" />
    </div>
  </section>

  <section class="sec dark">
    <div class="wrap">
      <H2 lead="Before & After" sub="Dryer Vent Cleaning Photos" tone="stone" center />
      <div class="grid grid-300" style="margin-top:48px">
        <figure class="dba">
          <Image src={dryerBa} alt="Dryer vent duct interior, before and after cleaning" width={720} loading="lazy" />
        </figure>
        {pairs.map((p) => (
          <div class="pair">
            <div class="pair__b"><span class="russo">Before</span></div>
            <div class="pair__a"><span class="russo">After</span></div>
            <div class="pair__cap">PHOTO · {p}</div>
          </div>
        ))}
      </div>
      <p class="caption">See exactly how much lint came out of your vent.</p>
    </div>
  </section>

  <section class="sec paper">
    <div class="wrap">
      <H2 lead="Benefits of Dryer Vent Cleaning" sub="for Your Home" center />
      <NumberCards items={benefits} card="white" />
    </div>
  </section>

  <section class="sec dark">
    <div class="wrap">
      <H2 lead="Signs Your Dryer Vent Needs Cleaning" sub="in Kansas City" tone="stone" center />
      <ArrowItems items={signs} />
    </div>
  </section>

  <section class="sec paper">
    <div class="wrap">
      <H2 lead="Our Dryer Vent Cleaning Process" sub="in Kansas City" center />
      <Steps items={steps} card="white" arrow="ink" />
    </div>
  </section>

  <Callout
    on="dark"
    lead="Getting your air ducts cleaned?"
    sub="Add dryer vent cleaning in the same visit."
    cta="See Air Duct Cleaning →"
    href="/services/air-duct-cleaning/"
  />

  <Callout
    on="light"
    lead="Builders, Remodelers & House Flippers"
    sub="in Kansas City"
    text="Make sure dryer vents are clear and properly connected before move-in or listing."
    cta="Call About a Project"
    href={business.tel}
    pmax="32em"
  />

  <section class="sec dark">
    <div class="wrap">
      <H2 lead="What Kansas City Customers Say" sub="About Our Dryer Vent Cleaning" tone="stone" center />
      <ReviewStrip reviews={dryerReviews} on="dark" />
    </div>
  </section>

  <section class="sec paper">
    <div class="wrap">
      <H2 lead="Dryer Vent Cleaning FAQ" sub="for Kansas City" center />
      <FaqList faqs={dryerFaqs} maxw="960px" />
    </div>
  </section>

  <section class="sec dark">
    <div class="wrap">
      <H2 lead="Related Services" sub="in Kansas City" tone="stone" center />
      <RelatedCards items={[serviceByKey('duct')]} card="paper" />
    </div>
  </section>
</Base>

<style>
  .dhero { width: 100%; height: auto; border-radius: 16px; min-height: clamp(300px, 36vw, 460px); max-height: 520px; object-fit: cover; display: block; }
  .dba { margin: 0; position: relative; border-radius: 16px; overflow: hidden; background: var(--blue-deep); }
  .dba img { width: 100%; height: 100%; min-height: 220px; object-fit: cover; display: block; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; border-radius: 16px; overflow: hidden; }
  .pair__b, .pair__a { min-height: 220px; display: flex; align-items: flex-end; padding: 12px; }
  .pair__b { background: repeating-linear-gradient(135deg, color-mix(in srgb, var(--slate) 25%, var(--mist)) 0 12px, color-mix(in srgb, var(--slate) 18%, var(--mist)) 12px 24px); }
  .pair__a { background: repeating-linear-gradient(135deg, color-mix(in srgb, var(--slate) 12%, var(--mist)) 0 12px, var(--mist) 12px 24px); }
  .pair span { padding: 6px 10px; border-radius: 6px; font-size: 13px; }
  .pair__b span { background: var(--slate); color: var(--white); }
  .pair__a span { background: var(--white); color: var(--slate); }
  .pair__cap { grid-column: 1 / -1; background: var(--mist); color: var(--slate); padding: 10px 14px; font-family: 'JetBrains Mono', monospace; font-size: 12px; }
  .caption { margin: 32px auto 0; text-align: center; font-size: 20px; font-weight: 600; max-width: 30em; text-wrap: balance; }
</style>
