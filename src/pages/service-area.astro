---
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import HeroButtons from '../components/HeroButtons.astro';
import Chips from '../components/Chips.astro';
import H2 from '../components/H2.astro';
import NumberCards from '../components/NumberCards.astro';
import RelatedCards from '../components/RelatedCards.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import FaqList from '../components/FaqList.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { business, services, areaGroups, areaCounties } from '../data/site';
import { areaReviews } from '../data/reviews';
import { areaFaqs } from '../data/faqs';
import { graph, localBusinessWithCities, faqPage } from '../data/schema';

const local = [
  { t: 'Fast scheduling', d: 'Being local means we can often get to you the next day.' },
  { t: 'We know KC homes', d: 'From older Northland homes that have never had their ducts cleaned to brand-new builds.' },
  { t: 'The owner shows up', d: 'No call center and no dispatch from out of state.' },
];
---
<Base
  page="area"
  title="Air Duct & Dryer Vent Cleaning Across the Kansas City Metro | Duct Hunt"
  description="Based in North Kansas City and serving the Northland, Kansas City, Independence, Lee's Summit, Overland Park, Olathe and more on both sides of the state line."
  schema={graph(localBusinessWithCities(), faqPage(areaFaqs))}
>
  <PhotoHero lead="Air Duct & Dryer Vent Cleaning Across the" accent="Kansas City Metro" narrow pad="clamp(48px,7vw,96px) var(--gutter) clamp(48px,8vw,104px)">
    <p class="lead" style="max-width:34em">Based in North Kansas City and serving homeowners, builders, and remodelers on both sides of the state line.</p>
    <HeroButtons quoteHref="/quote/" />
    <Chips items={['4.9★ Google', 'Locally Owned', 'Often Next-Day', 'All Work Guaranteed']} />
  </PhotoHero>

  <section class="sec paper">
    <div class="wrap split">
      <MapEmbed minHeight="clamp(340px,42vw,540px)" />
      <div>
        <H2 lead="Headquartered in" sub="North Kansas City" />
        <p class="body-lg" style="margin:24px 0 0">Duct Hunt is headquartered in North Kansas City, which puts us minutes from the Northland and a short drive to the rest of the metro.</p>
        <p class="body-lg" style="margin:16px 0 0">Not sure if we come to you? Call and ask. If you're in the KC area, the answer is probably yes.</p>
        <a href={business.tel} class="btn btn--ink mt28" style="border:0">Call {business.phone}</a>
      </div>
    </div>
  </section>

  <section class="sec dark">
    <div class="wrap">
      <H2 lead="Cities We Serve" sub="in the Kansas City Metro" tone="stone" center />
      <div class="grid grid-320" style="margin-top:48px">
        {areaGroups.map((g) => (
          <div class="group">
            <h3>{g.t}</h3>
            <ul class="pill-list" style="gap:8px">{g.cities.map((c) => <li class="pill" style="padding:8px 14px">{c}</li>)}</ul>
          </div>
        ))}
      </div>
      <div class="counties">
        <h3>Counties We Serve</h3>
        <ul>{areaCounties.map((c) => <li>{c}</li>)}</ul>
      </div>
      <p class="center body-lg" style="margin:32px auto 0;max-width:30em;text-wrap:balance">
        Don't see your city? Call <a href={business.tel} style="color:var(--white);font-weight:800">{business.phone}</a>, and we may still be able to help.
      </p>
    </div>
  </section>

  <section class="sec paper">
    <div class="wrap">
      <H2 lead="Services Available" sub="Everywhere We Serve" center />
      <RelatedCards items={services} card="white" min={300} />
    </div>
  </section>

  <section class="sec dark">
    <div class="wrap">
      <H2 lead="Why Local" sub="Matters" tone="stone" center />
      <div class="local"><NumberCards items={local} card="paper" /></div>
    </div>
  </section>

  <section class="sec paper">
    <div class="wrap">
      <H2 lead="What Kansas City Customers" sub="Say About Duct Hunt" center />
      <ReviewStrip reviews={areaReviews} on="light" />
    </div>
  </section>

  <section class="sec white rule">
    <div class="wrap">
      <H2 lead="Service Area FAQ" sub="for Kansas City" center />
      <FaqList faqs={areaFaqs} maxw="960px" />
    </div>
  </section>
</Base>

<style>
  .group { background: var(--mist); color: var(--slate); border-radius: 18px; padding: 28px; }
  .group h3 { margin: 0 0 16px; font-weight: 900; font-size: 24px; line-height: 1.1; }
  .counties { margin: 40px auto 0; max-width: 900px; text-align: center; }
  .counties h3 { margin: 0 0 16px; font-weight: 900; font-size: 24px; }
  .counties ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .counties li { padding: 10px 18px; border-radius: 999px; border: 2px solid var(--blue-soft); font-weight: 700; font-size: 16px; }
  /* "Why local" cards are 300px min with body text (shared cards default to 240px) */
  .local :global(.grid) { grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
</style>
