---
import { Image } from 'astro:assets';
import logoBlack from '../assets/logo-black.png';
import { business, services, type PageKey } from '../data/site';

interface Props {
  page: PageKey;
  /** Link for "Free Quote" (keeps the service pre-selected on service pages) */
  quoteHref: string;
}
const { page, quoteHref } = Astro.props;
const simple = page === 'quote';
const svcPages: PageKey[] = ['services', 'duct', 'dryer'];
const cur = (on: boolean) => (on ? 'page' : undefined);

const nav = [
  { label: 'Reviews', href: '/reviews/', on: page === 'reviews' },
  { label: 'Why Duct Hunt', href: '/why-duct-hunt/', on: page === 'why' },
  { label: 'Service Area', href: '/service-area/', on: page === 'area' },
  { label: 'FAQ', href: '/faq/', on: page === 'faq' },
];
---
{!simple && (
  <div class="topbar dnav">
    <div class="topbar__in">
      <a href={business.tel} class="topbar__item topbar__item--first"><span aria-hidden="true">✆</span>{business.phone}</a>
      <a href={`mailto:${business.email}`} class="topbar__item"><span aria-hidden="true">✉</span>{business.email}</a>
      <span class="topbar__area">Serving the Kansas City metro</span>
    </div>
  </div>
)}
<header class="hdr">
  <div class="hdr__in">
    <a href="/" aria-label="Duct Hunt LLC home" class="hdr__logo">
      <Image src={logoBlack} alt="Duct Hunt LLC" width={184} densities={[1, 2]} loading="eager" fetchpriority="low" />
    </a>
    {!simple && (
      <nav class="dnav hdr__nav" aria-label="Main">
        <a href="/" aria-current={cur(page === 'home')}>Home</a>
        <div class="dd">
          <a href="/services/" aria-haspopup="true" aria-current={cur(svcPages.includes(page))} class="dd__top">
            Services <span aria-hidden="true" class="dd__caret">▾</span>
          </a>
          <div class="dd__menu">
            <div class="dd__panel">
              <a href="/services/" class="dd__all" data-cur={page === 'services' || undefined}>All Services</a>
              {services.map((s) => (
                <a href={s.href} data-cur={page === s.key || undefined}>{s.name}</a>
              ))}
            </div>
          </div>
        </div>
        {nav.map((n) => <a href={n.href} aria-current={cur(n.on)}>{n.label}</a>)}
      </nav>
    )}
    <div class="hdr__cta">
      {!simple && <a class="hphone hdr__quote" href={quoteHref}>Free Quote</a>}
      <a href={business.tel} class="hdr__call">Call<span class="hdr__num">{'\u00a0'}{business.phone}</span></a>
      {!simple && (
        <button type="button" class="burger" id="nav-toggle" aria-expanded="false" aria-controls="mnav" aria-label="Open menu">
          <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
        </button>
      )}
    </div>
  </div>
  {!simple && (
    <nav class="mnav" id="mnav" aria-label="Mobile" hidden>
      <a href="/" aria-current={cur(page === 'home')}>Home</a>
      <a href="/services/" aria-current={cur(page === 'services')}>Services</a>
      <div class="mnav__sub">
        {services.map((s) => <a href={s.href} aria-current={cur(page === s.key)}>{s.name}</a>)}
      </div>
      {nav.map((n) => <a href={n.href} aria-current={cur(n.on)}>{n.label}</a>)}
      <div class="mnav__cta">
        <a href={quoteHref} class="mnav__quote">Get a Free Quote</a>
        <a href={business.tel} class="mnav__call">Call {business.phone}</a>
      </div>
    </nav>
  )}
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mnav');
  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.documentElement.classList.toggle('nav-open', open);
  };
  toggle?.addEventListener('click', () => setOpen(menu?.hidden ?? false));
  menu?.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setOpen(false); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); }
  });
  matchMedia('(min-width: 1101px)').addEventListener('change', (m) => { if (m.matches) setOpen(false); });
</script>

<style>
  .topbar { background: var(--slate); color: var(--white); font-size: 15px; }
  .topbar__in { max-width: 1280px; margin: auto; padding: 0 clamp(16px, 4vw, 48px); display: flex; align-items: stretch; }
  .topbar__item {
    display: flex; align-items: center; gap: 10px; padding: 0 24px; min-height: 48px;
    color: var(--white); text-decoration: none; border-right: 1px solid color-mix(in srgb, var(--white) 30%, transparent);
  }
  .topbar__item--first { padding-left: 0; font-weight: 600; }
  .topbar__area { margin-left: auto; align-self: center; }

  .hdr {
    position: sticky; top: 0; z-index: 50; background: var(--white); color: var(--slate);
    border-bottom: 1px solid var(--line); backdrop-filter: blur(8px);
  }
  .hdr__in {
    max-width: 1280px; margin: auto; padding: 0 clamp(16px, 4vw, 48px); min-height: 72px;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
  }
  .hdr__logo { display: flex; align-items: center; }
  .hdr__logo img { height: 56px; width: auto; display: block; }
  .hdr__nav { display: flex; gap: 28px; align-items: center; font-weight: 600; font-size: 16px; }
  .hdr__nav a, .hphone { white-space: nowrap; }
  .hdr__nav > a, .dd__top { color: var(--slate); text-decoration: none; padding: 12px 0; }
  .hdr__nav [aria-current='page'], .mnav [aria-current='page'] { box-shadow: inset 0 -3px 0 var(--blue); }
  .dd { position: relative; }
  .dd__top { display: inline-flex; align-items: center; gap: 6px; }
  .dd__caret { font-size: 11px; }
  .dd__menu { display: none; position: absolute; left: -16px; top: 100%; padding-top: 8px; min-width: 280px; z-index: 70; }
  .dd:hover .dd__menu, .dd:focus-within .dd__menu { display: block; }
  .dd__panel {
    background: var(--white); color: var(--slate); border: 1px solid var(--line); border-radius: 12px; padding: 8px;
    box-shadow: 0 12px 32px var(--shadow); display: grid; gap: 2px;
  }
  .dd__panel a { color: var(--slate); text-decoration: none; font-weight: 600; padding: 12px 14px; border-radius: 8px; }
  .dd__panel a:hover { background: var(--mist); }
  .dd__panel a[data-cur] { background: var(--mist); color: var(--blue-deep); }
  .dd__panel .dd__all { font-weight: 800; border-bottom: 1px solid var(--line); }
  .hdr__cta { display: flex; gap: 10px; align-items: center; }
  .hdr__quote { color: var(--blue); font-weight: 700; text-decoration: underline; text-underline-offset: 4px; padding: 12px 4px; }
  .hdr__call {
    background: var(--blue); color: var(--white); text-decoration: none; font-weight: 800; min-height: 48px; border-radius: 8px;
    padding: 0 20px; display: inline-flex; align-items: center; white-space: nowrap; transition: background-color 0.15s;
  }
  .hdr__call:hover { background: var(--blue-deep); }
  /* Hamburger + mobile menu */
  .burger {
    display: none; width: 48px; height: 48px; border: 1px solid var(--line-field); border-radius: 8px; background: var(--white);
    cursor: pointer; padding: 0; flex-direction: column; align-items: center; justify-content: center; gap: 5px;
  }
  .burger span { width: 22px; height: 2px; background: var(--slate); border-radius: 2px; transition: transform 0.2s, opacity 0.2s; }
  .burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .mnav {
    position: absolute; left: 0; right: 0; top: 100%; background: var(--white); border-bottom: 1px solid var(--line);
    box-shadow: 0 16px 32px var(--shadow); padding: 8px clamp(16px, 4vw, 48px) 20px;
    max-height: calc(100dvh - 73px); overflow-y: auto; display: flex; flex-direction: column;
  }
  .mnav[hidden] { display: none; }
  .mnav > a, .mnav__sub a {
    color: var(--slate); text-decoration: none; font-weight: 700; font-size: 18px; padding: 14px 4px;
    border-bottom: 1px solid var(--line);
  }
  .mnav__sub { display: flex; flex-direction: column; }
  .mnav__sub a { font-weight: 600; font-size: 16px; padding: 12px 4px 12px 20px; color: var(--text-muted); }
  .mnav [aria-current='page'] { color: var(--slate); box-shadow: inset 3px 0 0 var(--blue); padding-left: 14px; }
  .mnav__sub [aria-current='page'] { padding-left: 20px; }
  .mnav__cta { display: grid; gap: 10px; margin-top: 20px; }
  .mnav__cta a {
    min-height: 54px; border-radius: 8px; display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 18px; text-decoration: none; border: 2px solid var(--blue);
  }
  .mnav__quote { background: var(--blue); color: var(--white); }
  .mnav__call { background: var(--white); color: var(--blue-deep); }
  :global(html.nav-open) { overflow: hidden; }

  @media (max-width: 1100px) {
    .dnav, .hphone { display: none !important; }
    .burger { display: inline-flex; }
  }
  @media (min-width: 1101px) {
    .mnav { display: none !important; }
  }
  @media (max-width: 420px) {
    .hdr__logo img { height: 44px; }
    .hdr__call { padding: 0 14px; font-size: 15px; }
  }
  @media (max-width: 360px) {
    .hdr__num { display: none; }
  }
</style>
