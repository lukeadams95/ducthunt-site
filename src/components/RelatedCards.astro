---
import type { Service } from '../data/site';

interface Props {
  items: Service[];
  /** paper = cards on a dark section · white = cards on a light section (invert on hover) */
  card: 'paper' | 'white';
  min?: number;
}
const { items, card, min = 320 } = Astro.props;
---
<div class="grid" style={`margin-top:40px;grid-template-columns:repeat(auto-fit,minmax(min(100%,${min}px),1fr))`}>
  {items.map((s) => (
    <a href={s.href} class:list={['link-card', card === 'paper' ? 'rc-paper' : 'rc-white']}>
      <span><strong>{s.name}</strong><span>{s.blurb}</span></span>
      <span aria-hidden="true">→</span>
    </a>
  ))}
</div>

<style>
  .rc-paper { background: var(--mist); }
  .rc-paper:hover { background: var(--white); color: var(--slate); }
  .rc-white { background: var(--white); }
  .rc-white:hover { background: var(--blue); color: var(--white); }
</style>
