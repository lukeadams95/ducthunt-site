---
import { Image } from 'astro:assets';
import before from '../assets/slider-before.png';
import after from '../assets/slider-after.png';
---
<div class="ba">
  <div aria-hidden="true" class="ba__ring ba__ring--a"></div>
  <div aria-hidden="true" class="ba__ring ba__ring--b"></div>
  <div class="ba__lens" style="--sp:50">
    <Image src={after} alt="Air duct interior after cleaning" width={904} loading="eager" class="ba__img" draggable="false" />
    <Image src={before} alt="Air duct interior before cleaning, packed with dust" width={904} loading="eager" class="ba__img ba__img--before" draggable="false" />
    <span aria-hidden="true" class="ba__line"></span>
    <span aria-hidden="true" class="ba__handle">↔</span>
    <span class="ba__lbl ba__lbl--b russo">Before</span>
    <span class="ba__lbl ba__lbl--a russo">After</span>
    <input type="range" min="0" max="100" step="1" value="50" aria-label="Drag to compare before and after duct cleaning" class="ba__range" />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.ba__lens').forEach((lens) => {
    const range = lens.querySelector<HTMLInputElement>('.ba__range')!;
    const b = lens.querySelector<HTMLElement>('.ba__lbl--b')!;
    const a = lens.querySelector<HTMLElement>('.ba__lbl--a')!;
    const update = () => {
      const v = +range.value;
      lens.style.setProperty('--sp', String(v));
      // Fade a label out once its side is nearly gone
      b.style.opacity = v > 20 ? '1' : '0';
      a.style.opacity = v < 80 ? '1' : '0';
    };
    range.addEventListener('input', update);
    update();
  });
</script>

<style>
  .ba {
    position: relative; background: transparent; display: grid; place-items: center;
    padding: clamp(28px, 5vw, 64px); overflow: hidden; min-height: clamp(380px, 48vw, 720px);
  }
  .ba__ring { position: absolute; aspect-ratio: 1 / 1; border-radius: 50%; }
  .ba__ring--a { width: 74%; border: 2px solid color-mix(in srgb, var(--white) 10%, transparent); left: -18%; top: -6%; }
  .ba__ring--b { width: 62%; border: 2px solid color-mix(in srgb, var(--white) 8%, transparent); right: -14%; bottom: -8%; }
  .ba__lens {
    position: relative; width: min(100%, 560px); aspect-ratio: 1 / 1; border-radius: 50%; overflow: hidden;
    border: 6px solid var(--white); box-shadow: 0 20px 60px color-mix(in srgb, var(--slate) 40%, transparent); background: var(--slate); touch-action: pan-y;
  }
  .ba__img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%;
    -webkit-user-drag: none; user-select: none;
  }
  .ba__img--before { clip-path: inset(0 calc(100% - var(--sp) * 1%) 0 0); }
  .ba__line {
    position: absolute; top: 0; bottom: 0; left: clamp(4%, var(--sp) * 1%, 96%); width: 3px; margin-left: -1.5px;
    background: var(--white); box-shadow: 0 0 12px color-mix(in srgb, var(--slate) 45%, transparent);
  }
  .ba__handle {
    position: absolute; top: 50%; left: clamp(4%, var(--sp) * 1%, 96%); width: 48px; height: 48px; margin: -24px 0 0 -24px;
    border-radius: 50%; background: var(--white); color: var(--blue); display: grid; place-items: center; font-weight: 900;
    font-size: 20px; box-shadow: 0 0 0 3px var(--blue-soft), 0 4px 16px color-mix(in srgb, var(--slate) 40%, transparent);
  }
  .ba__lbl { transition: opacity 0.15s; position: absolute; bottom: 15%; padding: 5px 12px; border-radius: 6px; font-size: 14px; }
  .ba__lbl--b { left: 12%; background: var(--slate); color: var(--white); }
  .ba__lbl--a { right: 12%; background: var(--white); color: var(--slate); }
  .ba__range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .ba:has(.ba__range:focus-visible) .ba__handle { outline: 3px solid var(--white); outline-offset: 3px; }
</style>
