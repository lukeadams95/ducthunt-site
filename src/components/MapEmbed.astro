---
import { business } from '../data/site';

interface Props {
  minHeight: string;
  radius?: number;
  shadow?: boolean;
}
const { minHeight, radius = 16, shadow = false } = Astro.props;
---
<div class="map" style={`border-radius:${radius}px;min-height:${minHeight};${shadow ? 'box-shadow:0 12px 40px rgba(0,0,0,.35);' : ''}`}>
  <iframe
    title="Duct Hunt location map"
    src={business.mapEmbed}
    style={`min-height:${minHeight}`}
    allowfullscreen
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"></iframe>
</div>

<style>
  .map { overflow: hidden; background: var(--soft); }
  .map iframe { border: 0; width: 100%; height: 100%; display: block; }
</style>
