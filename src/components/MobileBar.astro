---
import { business } from '../data/site';

interface Props {
  quoteHref: string;
}
const { quoteHref } = Astro.props;
---
<nav class="mbar" aria-label="Quick contact">
  <a href={business.tel} class="mbar__call">Call {business.phone}</a>
  <a href={quoteHref} class="mbar__quote">Quote</a>
</nav>

<style>
  .mbar {
    display: none; position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
    grid-template-columns: 2fr 1fr; border-top: 2px solid var(--ink);
  }
  .mbar a {
    font-weight: 800; font-size: 18px; text-decoration: none; min-height: 64px;
    display: flex; align-items: center; justify-content: center;
  }
  .mbar__call { background: var(--ink); color: #fff; }
  .mbar__quote { background: #fff; color: var(--ink); }
  @media (max-width: 820px) {
    .mbar { display: grid; }
    :global(body) { padding-bottom: 64px; }
    :global(html.nav-open) .mbar { display: none; }
  }
</style>
