---
import { business } from '../data/site';

interface Props {
  /** Text after the stars, e.g. "on Google" or "· 54 Google Reviews" */
  suffix?: string;
  label?: string;
  size?: 'sm' | 'md';
}
const { suffix = 'on Google', label = `${business.rating} rating on Google. Read our reviews`, size = 'md' } = Astro.props;
---
<a href={business.googleUrl} target="_blank" rel="noopener" aria-label={label} class:list={['gbadge', `gbadge--${size}`]}>
  <span aria-hidden="true" class="gbadge__g"><span>G</span></span>
  <span>{business.rating}</span>
  <span aria-hidden="true" class="gbadge__stars">★★★★★</span>
  <span class="gbadge__suffix">{suffix}</span>
</a>

<style>
  .gbadge {
    display: inline-flex; flex-wrap: wrap; white-space: nowrap; align-items: center; gap: 10px; background: #fff; color: var(--ink);
    text-decoration: none; padding: 6px 18px 6px 6px; border-radius: 999px; font-weight: 700;
    transition: background-color 0.15s;
  }
  .gbadge:hover { background: #f1f0ef; color: var(--ink); }
  .gbadge--sm { padding: 6px 16px 6px 6px; font-size: 15px; }
  .gbadge--sm .gbadge__suffix { font-weight: 600; }
  .gbadge__g {
    width: 30px; height: 30px; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 1px #dadce0;
    display: grid; place-items: center; font-weight: 900; font-size: 19px; font-family: Arial, Helvetica, sans-serif;
  }
  .gbadge__g span {
    background: conic-gradient(from -45deg, #ea4335 0 25%, #fbbc05 0 50%, #34a853 0 75%, #4285f4 0);
    -webkit-background-clip: text; background-clip: text; color: transparent; line-height: 1;
  }
  .gbadge__stars { letter-spacing: 1px; color: #fbbc05; }
</style>
