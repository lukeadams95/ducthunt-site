---
// "Latest posts" block for the homepage (Nov 20, 2026).
// Same source as /blog (getPosts: published, newest first). Future-dated posts
// are excluded (America/Chicago date). Static links in the built HTML.
import H2 from './H2.astro';
import { getPosts, isoDate, displayDate } from '../lib/blog';

const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Chicago', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
const latest = (await getPosts()).filter((p) => isoDate(p.data.date) <= today).slice(0, 3);
---
{latest.length > 0 && (
  <section class="sec paper rule" aria-label="Latest posts">
    <div class="wrap-1100" id="latest-posts-heading">
      <H2 lead="Latest posts" center maxw="16em" />
      <ul class="lp grid grid-300">
        {latest.map((p) => (
          <li class="lp__item">
            <p class="lp__meta"><time datetime={isoDate(p.data.date)}>{displayDate(p.data.date)}</time></p>
            <h3 class="lp__h"><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
          </li>
        ))}
      </ul>
      <p class="lp__all"><a href="/blog/">View all posts</a></p>
    </div>
  </section>
)}

<style>
  .lp { list-style: none; margin: 32px 0 0; padding: 0; }
  .lp__item { background: var(--white); border: 2px solid var(--line); border-radius: 12px; padding: clamp(20px, 3vw, 28px); }
  .lp__meta { margin: 0; font-size: 15px; color: var(--text-muted); }
  .lp__h { margin: 8px 0 0; font-weight: 900; font-size: clamp(20px, 2.4vw, 24px); line-height: 1.15; letter-spacing: -0.01em; text-wrap: balance; }
  .lp__h a { color: var(--slate); text-decoration: none; }
  .lp__h a:hover { color: var(--blue-deep); text-decoration: underline; }
  .lp__all { margin: 24px 0 0; text-align: center; }
  .lp__all a { color: var(--blue-deep); font-weight: 800; }
</style>
