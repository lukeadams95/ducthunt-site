---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PhotoHero from '../../components/PhotoHero.astro';
import HeroButtons from '../../components/HeroButtons.astro';
import Chips from '../../components/Chips.astro';
import H2 from '../../components/H2.astro';
import IconItems from '../../components/IconItems.astro';
import NumberCards from '../../components/NumberCards.astro';
import Steps from '../../components/Steps.astro';
import ReviewStrip from '../../components/ReviewStrip.astro';
import FaqList from '../../components/FaqList.astro';
import RelatedCards from '../../components/RelatedCards.astro';
import Callout from '../../components/Callout.astro';
import BeforeAfterLens from '../../components/BeforeAfterLens.astro';
import ba1 from '../../assets/ba-duct-1.jpg';
import ba2 from '../../assets/ba-duct-2.jpg';
import ba3 from '../../assets/ba-duct-3.jpg';
import ba4 from '../../assets/ba-duct-4.jpg';
import ba5 from '../../assets/ba-duct-5.jpg';
import { business, serviceByKey } from '../../data/site';
import { ductReviews } from '../../data/reviews';
import { ductFaqs } from '../../data/faqs';

const included = [
  ['▦', 'All supply vents and registers'],
  ['↺', 'Return air vents and ducts'],
  ['═', 'Main trunk lines'],
  ['✺', 'Blower compartment area'],
  ['◩', 'Before & after photos of your ducts'],
  ['✦', 'Cleanup of the work area when finished'],
  ['✎', 'Filter recommendations and maintenance tips'],
].map(([i, t]) => ({ i, t }));
const photos = [
  { src: ba1, alt: 'Supply duct interior before and after cleaning', cap: 'Top: before. Bottom: after.' },
  { src: ba2, alt: 'Duct with debris before and clean duct after', cap: 'Top: before. Bottom: after.' },
  { src: ba3, alt: 'Vent opening between framing before and after cleaning', cap: 'Top: before. Bottom: after.' },
  { src: ba4, alt: 'Duct runs before and after cleaning, two pairs', cap: 'Top row: before. Bottom row: after.' },
  { src: ba5, alt: 'Duct interior and register from a Duct Hunt job', cap: 'Duct interior and register from a recent job.' },
];
const benefits = ['Less dust around the house', 'Fresher-smelling air', 'Better airflow from your vents', "HVAC system that doesn't work as hard"].map((t) => ({ t }));
const signCols = [
  ['Dust builds up fast after cleaning', 'Musty or stale smell when the system runs', 'Weak airflow from vents', 'You recently remodeled or did drywall work'],
  ["You moved into a home and don't know when ducts were last cleaned", 'Pets, smokers, or allergy sufferers in the home', 'Your home is older and the ducts have never been cleaned'],
];
const steps = [
  { t: 'Call for an upfront quote', d: 'Priced by vent count and home size.' },
  { t: 'Fast scheduling', d: 'Often next day, with a reminder before arrival.' },
  { t: 'Thorough cleaning', d: 'The full system cleaned, with before & after photos.' },
  { t: 'Walkthrough of results', d: 'Plus filter and maintenance tips.' },
];
const quoteHref = '/quote/?service=air-duct';
---
<Base
  page="duct"
  title="Air Duct Cleaning in Kansas City | Duct Hunt LLC"
  description="Thorough air duct cleaning in Kansas City, performed to NADCA standards. Upfront pricing, before & after photos and no hidden fees from a local owner."
  faqs={ductFaqs}
  pageServices={[serviceByKey('duct')]}
>
  <PhotoHero lead="Air Duct Cleaning in" accent="Kansas City">
    <p class="lead">Thorough, honest duct cleaning from a local owner-operator. Upfront pricing, before &amp; after photos, and no hidden fees.</p>
    <HeroButtons quoteHref={quoteHref} />
    <Chips items={['4.9★ Google', 'NADCA Standards', 'All Work Guaranteed', 'Locally Owned']} />
    <BeforeAfterLens slot="aside" />
  </PhotoHero>

  <section class="sec paper">
    <div class="wrap-880">
      <H2 lead="Air Duct Cleaning for Homes in" sub="North Kansas City and Beyond" />
      <p class="body-lg answer" style="margin:28px 0 0"><strong>Duct Hunt cleans the whole air duct system in Kansas City homes: every supply vent and register, the return vents and ducts, the main trunk lines and the blower compartment, performed to NADCA standards.</strong> Owner Derek Craig gives you an upfront price over the phone, does the work himself and shows you before and after photos. Most homes take about 2 hours.</p>
      <p class="body-lg" style="margin:18px 0 0">Over time, dust, pet hair, construction debris, and allergens build up inside your ductwork and get blown back into every room. A full cleaning helps your home breathe easier and keeps your HVAC from working as hard.</p>
    </div>
  </section>

  <section class="sec dark">
    <div class="wrap">
      <H2 lead="What's Included in Our Air Duct Cleaning" sub="in Kansas City" tone="stone" center />
      <IconItems items={included} card="paper" />
    </div>
  </section>

  <section id="how-pricing-works" class="sec white">
    <div class="wrap-880">
      <H2 lead="How Pricing Works" sub="for Air Duct Cleaning" />
      <p class="body-lg" style="margin:24px 0 0">Every home is different, so your quote is built around your home. These are the things that change it:</p>
      <ul class="price-list">
        <li><span aria-hidden="true">→</span><span><strong>Vent count.</strong> The number of supply and return vents in the home.</span></li>
        <li><span aria-hidden="true">→</span><span><strong>Home size.</strong> Larger homes have more ductwork to clean.</span></li>
        <li><span aria-hidden="true">→</span><span><strong>Access.</strong> How easy the ducts and blower compartment are to reach.</span></li>
        <li><span aria-hidden="true">→</span><span><strong>Adding the dryer vent line.</strong> Dryer vent cleaning is a flat fee, so adding it to your visit is simple to price.</span></li>
      </ul>
      <p class="body-lg" style="margin:24px 0 0">Call <a href={business.tel} class="tel-link">{business.phone}</a> and Derek can usually give you an upfront price over the phone, with no in-home estimate needed. The price you're quoted is the price you pay, with no hidden fees.</p>
    </div>
  </section>

  <section id="ducts-and-dryer-vent" class="sec paper">
    <div class="wrap-880">
      <H2 lead="Ducts and Dryer Vent" sub="in One Visit" />
      <p class="body-lg" style="margin:24px 0 0">Many customers have both done at once. While Derek is cleaning your air ducts, he can also clean the full dryer vent line from the dryer to the exterior, clear the transition duct and the exterior opening, and finish with an airflow check. One visit, one quote, and the dryer vent part is a flat fee.</p>
      <p class="body-lg" style="margin:18px 0 0"><a href="/services/dryer-vent-cleaning/" class="tel-link">See what dryer vent cleaning includes →</a></p>
    </div>
  </section>

  <section id="no-upsell" class="sec white">
    <div class="wrap-880">
      <H2 lead="No Upsell," sub="No Pressure" />
      <p class="body-lg" style="margin:24px 0 0">You get the cleaning you were quoted. If there are optional add-ons that might help your home, Derek will explain them and let you decide. There's never any pressure, and the person who quotes your job is the person who shows up.</p>
    </div>
  </section>

  <section id="nadca-standards" class="sec paper">
    <div class="wrap-880">
      <H2 lead="Performed to" sub="NADCA Standards" />
      <p class="body-lg" style="margin:24px 0 0">NADCA is the National Air Duct Cleaners Association. Our air duct cleaning is performed to its standards, and every cleaning covers the full system: supply vents and registers, return vents and ducts, the main trunk lines and the blower compartment, not just the vent covers you can see.</p>
    </div>
  </section>

  <section id="light-duct-repair" class="sec white">
    <div class="wrap-1100">
      <H2 lead="Light Duct Repair" sub="During Your Cleaning" center />
      <p class="body-lg center" style="margin:20px auto 0;max-width:36em">Derek handles minor duct repairs during air duct cleaning services, such as taping small holes or fixing loose or disconnected ductwork when the repair can be easily completed on the spot.</p>
      <div class="repair">
        <div class="repair__card on-paper">
          <span aria-hidden="true" class="icon-ring">✓</span>
          <h3>Fixed on the spot</h3>
          <ul>
            <li><span aria-hidden="true">✓</span><span>Small holes taped</span></li>
            <li><span aria-hidden="true">✓</span><span>Loose ductwork secured</span></li>
            <li><span aria-hidden="true">✓</span><span>Disconnected ductwork reattached</span></li>
          </ul>
        </div>
        <div class="repair__card repair__card--ref">
          <span aria-hidden="true" class="icon-ring">→</span>
          <h3>Major repairs</h3>
          <p>For major duct repairs, he refers customers to another company.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec paper">
    <div class="wrap">
      <H2 lead="Before & After" sub="Air Duct Cleaning Photos" center />
      <div class="flex3 gallery" style="gap:20px">
        {photos.map((p) => (
          <figure>
            <Image src={p.src} alt={p.alt} width={640} loading="lazy" />
            <figcaption>{p.cap}</figcaption>
          </figure>
        ))}
      </div>
      <p class="caption">Every job is documented, so you see exactly what came out of your ducts.</p>
    </div>
  </section>

  <section class="sec dark">
    <div class="wrap">
      <H2 lead="Benefits of Air Duct Cleaning" sub="for Your Home" tone="stone" center />
      <NumberCards items={benefits} card="paper" />
    </div>
  </section>

  <section class="sec paper">
    <div class="wrap">
      <H2 lead="Signs You Need Air Duct Cleaning" sub="in Kansas City" center />
      <div class="sign-cols">
        {signCols.map((col) => (
          <ul>{col.map((s) => <li><span aria-hidden="true">→</span><span>{s}</span></li>)}</ul>
        ))}
      </div>
    </div>
  </section>

  <section class="sec dark">
    <div class="wrap">
      <H2 lead="Our Air Duct Cleaning Process" sub="in Kansas City" tone="stone" center />
      <Steps items={steps} card="paper" arrow="white" />
    </div>
  </section>

  <Callout
    on="light"
    lead="Builders, Remodelers & Real Estate Agents"
    sub="in Kansas City"
    text="Post-construction, post-remodel and pre-sale duct cleaning for builders, remodelers and flippers, with drywall dust and debris removed before move-in or listing. Real estate agents refer their buyers and sellers to us. Fast turnaround for project timelines, with before and after photos."
    cta="Call About a Project"
    href={business.tel}
    maxw="960px"
    hmax="16em"
  />

  <section class="sec dark">
    <div class="wrap">
      <H2 lead="What Kansas City Customers Say" sub="About Our Duct Cleaning" tone="stone" center />
      <ReviewStrip reviews={ductReviews} on="dark" />
    </div>
  </section>

  <section class="sec paper">
    <div class="wrap-960">
      <H2 lead="Air Duct Cleaning FAQ" sub="for Kansas City" center />
      <FaqList faqs={ductFaqs} />
    </div>
  </section>

  <section class="sec dark">
    <div class="wrap">
      <H2 lead="Related Services" sub="in Kansas City" tone="stone" center />
      <RelatedCards items={[serviceByKey('dryer')]} card="paper" />
    </div>
  </section>
</Base>

<style>
  .gallery > * { flex-basis: calc((100% - 40px) / 3); }
  .gallery figure { margin: 0; background: var(--white); border-radius: 16px; overflow: hidden; }
  .gallery img { display: block; width: 100%; height: auto; }
  .gallery figcaption { padding: 12px 16px; font-size: 15px; font-weight: 600; }
  .repair { margin-top: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 22px; }
  .repair__card { border-radius: 18px; padding: 28px 28px 30px; display: flex; flex-direction: column; gap: 14px; }
  .repair__card--ref { background: var(--white); border: 2px solid var(--line); }
  .repair__card h3 { margin: 0; font-weight: 800; font-size: 24px; line-height: 1.1; }
  .repair__card p { margin: 0; color: var(--text-muted); }
  .repair__card ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .repair__card li { display: grid; grid-template-columns: 28px 1fr; font-weight: 600; }
  .repair__card li span:first-child { color: var(--blue); font-weight: 900; }
  .price-list { list-style: none; margin: 20px 0 0; padding: 0; border-top: 2px solid var(--line); }
  .price-list li { padding: 14px 0; border-bottom: 2px solid var(--line); display: grid; grid-template-columns: 36px 1fr; font-size: 18px; }
  .price-list li span:first-child { font-weight: 900; }
  .tel-link { color: var(--blue); font-weight: 800; }
  .caption { margin: 32px auto 0; text-align: center; font-size: 20px; font-weight: 600; max-width: 30em; text-wrap: balance; }
  .sign-cols { margin-top: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 0 48px; }
  .sign-cols ul { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--line); align-self: start; }
  .sign-cols li { padding: 16px 0; border-bottom: 2px solid var(--line); display: grid; grid-template-columns: 36px 1fr; font-weight: 600; font-size: 18px; }
  .sign-cols li span:first-child { font-weight: 900; }
</style>
