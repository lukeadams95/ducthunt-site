---
import { Image } from 'astro:assets';
import hero from '../assets/hero.webp';
import { business } from '../data/site';

interface Props {
  /** Where "Request a Quote" goes: the homepage form, or the form on this page */
  quoteHref: string;
}
const { quoteHref } = Astro.props;
---
<section id="quote" class="banner dark">
  <Image src={hero} alt="" widths={[768, 1280, 1920]} sizes="100vw" class="banner__bg" />
  <div aria-hidden="true" class="banner__shade"></div>
  <div class="banner__in">
    <h2 class="banner__h">Request a Free Duct Cleaning Quote <span class="t-gray-d">in Kansas City</span></h2>
    <p class="banner__p">Prefer to talk? Call Derek directly. Otherwise request a quote and he'll get back to you.</p>
    <div class="banner__btns">
      <a href={quoteHref} class="btn btn--white banner__btn">Request a Quote</a>
      <a href={business.tel} class="btn btn--ghost-light banner__btn banner__btn--call">Call {business.phone}</a>
    </div>
  </div>
</section>

<style>
  .banner {
    position: relative; overflow: hidden; border-top: 2px solid var(--ink);
    padding: clamp(36px, 5vw, 64px) var(--gutter);
  }
  .banner__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 78% 50%; }
  .banner__shade { position: absolute; inset: 0; background: rgba(20, 18, 17, 0.74); }
  .banner__in { position: relative; max-width: 960px; margin: auto; text-align: center; }
  .banner__h {
    margin: 0 auto; max-width: 16em; font-weight: 900; font-size: clamp(34px, 5vw, 64px);
    line-height: 1; letter-spacing: -0.03em; text-wrap: balance;
  }
  .banner__p { margin: 14px auto 0; font-size: 20px; font-weight: 500; max-width: 30em; text-wrap: pretty; }
  .banner__btns { margin-top: 24px; display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; }
  .banner__btn { font-size: 22px; min-height: 64px; padding: 0 36px; border-radius: 8px; }
  .banner__btn--call:hover { background: rgba(255, 255, 255, 0.14); color: #fff; }
</style>
