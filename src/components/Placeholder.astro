---
interface Props {
  label: string;
  minHeight?: string;
  light?: boolean;
}
const { label, minHeight, light = false } = Astro.props;
const bg = light ? 'background:repeating-linear-gradient(135deg,var(--mist) 0 12px,var(--white) 12px 24px);' : '';
---
<div class="ph" role="img" aria-label={`Photo placeholder: ${label}`} style={`${bg}${minHeight ? `min-height:${minHeight}` : ''}`}>
  <span>PHOTO · {label}</span>
</div>
