---
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import HeroButtons from '../components/HeroButtons.astro';
import H2 from '../components/H2.astro';
import RelatedCards from '../components/RelatedCards.astro';
import { services } from '../data/site';

// Cloudflare Pages serves dist/404.html with a real 404 status for unknown URLs.
// Without this file it treats the site as an SPA and returns the homepage with 200 (soft 404s).
---
<Base
  page="notfound"
  title="Page Not Found | Duct Hunt"
  description="The page you were looking for isn't here. Find air duct and dryer vent cleaning in Kansas City from Duct Hunt."
  noindex
>
  <PhotoHero lead="Sorry, we can't find" accent="that page" narrow>
    <p class="lead">The link may be old or mistyped. Here's where to go instead, or call Derek and he'll help.</p>
    <HeroButtons quoteHref="/quote/" />
  </PhotoHero>

  <section class="sec paper">
    <div class="wrap">
      <H2 lead="Popular Pages" center />
      <RelatedCards items={services} card="white" min={300} />
      <p class="center body-lg" style="margin:32px auto 0">
        Or go to the <a href="/">homepage</a>, <a href="/service-area/">service area</a>, <a href="/reviews/">reviews</a> or <a href="/faq/">FAQ</a>.
      </p>
    </div>
  </section>
</Base>
