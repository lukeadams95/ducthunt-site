---
import Base from '../layouts/Base.astro';
import { services } from '../data/site';
import { getPosts } from '../lib/blog';

const posts = await getPosts();

const main = [
  { href: '/', label: 'Home' },
  { href: '/why-duct-hunt/', label: 'Why Duct Hunt' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/quote/', label: 'Free Quote' },
  { href: '/blog/', label: 'Blog' },
  { href: '/sitemap/', label: 'Site Map' },
];

const serviceLinks = [
  { href: '/services/', label: 'All Services' },
  ...services.map((s) => ({ href: s.href, label: s.name })),
];

const areaLinks = [
  { href: '/service-area/', label: 'Service Area' },
  { href: '/service-area/overland-park/', label: 'Overland Park' },
];

const blogLinks = posts.map((post) => ({
  href: `/blog/${post.data.slug}/`,
  label: post.data.title,
}));

const sections = [
  { title: 'Main pages', links: main },
  { title: 'Services', links: serviceLinks },
  { title: 'Service area', links: areaLinks },
  ...(blogLinks.length ? [{ title: 'Blog', links: blogLinks }] : []),
];
---
<Base
  page="sitemap"
  title="Site Map | Duct Hunt"
  description="A full list of pages on the Duct Hunt website, including services, service area, and blog posts."
>
  <section class="sec paper">
    <div class="wrap-960">
      <h1>Site Map</h1>
      <p class="lead" style="max-width:34em">Every public page on this site, grouped by section.</p>
      <div class="smap">
        {sections.map((section) => (
          <section>
            <h2>{section.title}</h2>
            <ul>
              {section.links.map((link) => (
                <li>
                  {link.href === '/sitemap/' ? (
                    <span>{link.label}</span>
                  ) : (
                    <a href={link.href}>{link.label}</a>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .smap { display: grid; gap: 40px; margin-top: 40px; }
  @media (min-width: 800px) { .smap { grid-template-columns: 1fr 1fr; } }
  .smap h2 { margin: 0 0 12px; font-size: 18px; text-transform: uppercase; letter-spacing: 0.08em; }
  .smap ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
</style>
